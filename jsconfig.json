{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "jsx": "react-native",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@components/*": ["src/components/*"],
      "@features": ["src/features/index.js"],
      "@features/*": ["src/features/*"],
      "@assets/*": ["src/assets/*"],
      "@config/*": ["src/config/*"]
    }
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}