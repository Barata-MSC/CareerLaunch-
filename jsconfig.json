{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "jsx": "react-native",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@components/*": ["src/components/*"],
      "@screens": ["src/screens/index.js"],
      "@screens/*": ["src/screens/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}